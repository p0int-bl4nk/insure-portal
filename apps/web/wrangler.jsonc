{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Production Worker: the SPA plus the lead API. `env.dev` below is the dev Worker.
  // The Vite plugin picks the environment at build time (CLOUDFLARE_ENV=dev vite build)
  // and writes a flattened config to dist/, which `wrangler deploy` reads.
  // `pnpm dev` sets CLOUDFLARE_ENV=dev. `pnpm preview` serves whichever build ran last
  // (`build` = prod, `build:dev` = dev), so run `build:dev` before previewing locally.
  "name": "insure-portal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-19",
  // No `directory`: the Vite plugin fills it in with its client build output.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // Prod serves only pb-alumni.com, whose DNS is on Cloudflare; no workers.dev URL.
  "routes": [{ "pattern": "pb-alumni.com", "custom_domain": true }],
  "workers_dev": false,
  // Prod serves only from the production branch; no workers.dev preview URLs for versions.
  "preview_urls": false,
  // Not secret. GOOGLE_SERVICE_ACCOUNT_JSON, TURNSTILE_SECRET_KEY and ALERT_WEBHOOK_URL
  // are secrets: `wrangler secret put <NAME> [--name insure-portal-dev]`, or .dev.vars locally.
  "vars": {
    "SPREADSHEET_ID": "1m6E4OWv-WCCDlQn_YBWSD74ojydPpqxGw11zqvwVzLo",
    "SHEET_LEADS_TAB": "Leads",
    "SHEET_MEMBERS_TAB": "Members",
    "TURNSTILE_ENABLED": "true",
    // Failed submissions are logged encrypted to this key; see README "Replaying failed submissions".
    "REPLAY_PUBLIC_KEY": "{\"kty\":\"RSA\",\"n\":\"ww7BsaOCojpUlw7z1M6AhrdRo3JBU5iSshhhUB3276oWGkY5rL6hs-6ZWOenoxiMGfKouHBZNkm98vl9PSudcsp_4I3xBiSG69Df-qSCuOgJzFuFZoEVdIs2n4Hz-6aSrhwSEjbr1bQF2qkEtOQeFohzLlIT7bBTnB0u6mtp829QhoGFRfFawePt18DJ0svqHiMzKNyTvXu42lQKJVZYCa8g5QLMl3OS4_vzuDFBHQ6OVSK2DFqkjpmn-3XQO33HKCecHMb9lfhsJfVB2JqvS6xX0y-VRc5d6G6fujsynytO5c-qV4RqpsMlJJj0bSTFC6W78LLUCyzh4whbpVhQ78VAgiJROj1DbVwoKSOcsKRN_drn-FIfVmzf62BC1Iawa7LTDl3DneNpHT93bd-VdQso_rzqheJF1415C0cwOd8g4nXj_9v1GL10w6AMuF2GFtTGZMxN9wf-1LsbTC5JWYxknSplBR-rgEmmqcWwO_J-F0YgGywwFHJ5BfxEBS1Z\",\"e\":\"AQAB\"}",
  },
  "env": {
    "dev": {
      "name": "insure-portal-dev",
      // `routes` and `workers_dev` are inherited, so dev overrides them to stay on workers.dev.
      "routes": [],
      "workers_dev": true,
      // PR branches upload preview versions to the dev Worker only.
      "preview_urls": true,
      // `vars` isn't inherited, so every key is repeated. `observability` is inherited
      // (https://developers.cloudflare.com/workers/wrangler/configuration/#inheritable-keys).
      "vars": {
        "SPREADSHEET_ID": "1xvJ77BcSc9yUkfb8eLlyMUSSrTqHSAgPQKSzJDJ9q5U",
        "SHEET_LEADS_TAB": "Leads",
        "SHEET_MEMBERS_TAB": "Members",
        "TURNSTILE_ENABLED": "true",
        "REPLAY_PUBLIC_KEY": "{\"kty\":\"RSA\",\"n\":\"ww7BsaOCojpUlw7z1M6AhrdRo3JBU5iSshhhUB3276oWGkY5rL6hs-6ZWOenoxiMGfKouHBZNkm98vl9PSudcsp_4I3xBiSG69Df-qSCuOgJzFuFZoEVdIs2n4Hz-6aSrhwSEjbr1bQF2qkEtOQeFohzLlIT7bBTnB0u6mtp829QhoGFRfFawePt18DJ0svqHiMzKNyTvXu42lQKJVZYCa8g5QLMl3OS4_vzuDFBHQ6OVSK2DFqkjpmn-3XQO33HKCecHMb9lfhsJfVB2JqvS6xX0y-VRc5d6G6fujsynytO5c-qV4RqpsMlJJj0bSTFC6W78LLUCyzh4whbpVhQ78VAgiJROj1DbVwoKSOcsKRN_drn-FIfVmzf62BC1Iawa7LTDl3DneNpHT93bd-VdQso_rzqheJF1415C0cwOd8g4nXj_9v1GL10w6AMuF2GFtTGZMxN9wf-1LsbTC5JWYxknSplBR-rgEmmqcWwO_J-F0YgGywwFHJ5BfxEBS1Z\",\"e\":\"AQAB\"}",
      },
    },
  },
}
