# Local development only. Copy to .dev.vars (never commit .dev.vars).
# Values here override `vars` in wrangler.jsonc for `pnpm dev` / `pnpm preview`,
# and `pnpm sheet:init` reads this file too.

# No SPREADSHEET_ID here: local runs use the dev Sheet ID from wrangler.jsonc `env.dev`.

# Service-account key JSON on one line, for the dev Sheet. Share the Sheet with its client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cloudflare Turnstile human check. wrangler.jsonc turns it on; set false to skip it locally.
TURNSTILE_ENABLED=false
# Only needed when enabled. This test secret always passes; pair with the test site key in .env.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# No ALERT_WEBHOOK_URL: it is set only on the prod Worker (`wrangler secret put ALERT_WEBHOOK_URL`).
