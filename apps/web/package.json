{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vite --host",
    "build": "tsc -b && vite build",
    "build:dev": "CLOUDFLARE_ENV=dev vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example",
    "sheet:init": "node --env-file-if-exists=.dev.vars worker/scripts/init-sheet.ts",
    "replay": "node --env-file-if-exists=.dev.vars worker/scripts/replay.ts",
    "replay:keygen": "node worker/scripts/replay-keygen.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "7.0.7",
    "@insure/shared": "workspace:*",
    "@marsidev/react-turnstile": "1.6.3",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tw-animate-css": "1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "vitest": "catalog:",
    "wrangler": "4.165.0"
  }
}
