{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2024"],
    // Generated by `pnpm cf-typegen`: Env from wrangler.jsonc plus the workerd runtime.
    "types": ["./worker/worker-configuration.d.ts"],
    "allowImportingTsExtensions": true
  },
  "include": ["worker"],
  // A Node CLI, typechecked by tsconfig.node.json.
  "exclude": ["worker/scripts"]
}
