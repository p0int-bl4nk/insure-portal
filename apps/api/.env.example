# Local development only. Copy to .env (never commit .env).

# Dev Google Sheet (NOT the production one). The ID is the long part of the sheet URL.
SPREADSHEET_ID=
SHEET_LEADS_TAB=Leads
SHEET_MEMBERS_TAB=Members

# Service-account key JSON on one line, for the dev Sheet. Share the Sheet with its client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cloudflare Turnstile human check. Off unless set to true (production should turn it on).
TURNSTILE_ENABLED=false
# Only needed when enabled. This test secret always passes; pair with the test site key in web/.env.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Local dev server port (Vite proxies /api here).
PORT=8787
