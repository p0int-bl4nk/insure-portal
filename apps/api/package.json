{
  "name": "@insure/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --minify --sourcemap --outfile=dist/index.mjs --external:@aws-sdk/* \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "dev": "tsx watch --env-file-if-exists=.env src/dev-server.ts",
    "sheet:init": "tsx --env-file-if-exists=.env src/scripts/init-sheet.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1171.0",
    "@insure/shared": "workspace:*",
    "google-auth-library": "11.3.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
